<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置。注意本示例同时启用了 NativeAOT，
  故必须用「文件/代码配置」而非依赖反射的类型发现。
  日志同时输出到控制台与滚动文件。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <targets>
    <!-- 控制台：便于开发时观察 -->
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:|${exception:format=tostring}}" />

    <!-- 滚动文件：按天切分，保留 7 天，单文件超 10MB 再切 -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/nanoserver-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:|${exception:format=tostring}}"
            archiveEvery="Day"
            maxArchiveFiles="7"
            archiveAboveSize="10485760"
            keepFileOpen="false"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- 框架自身的 Info 级噪音较多，只记 Warning 以上 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- 本项目日志全量记录 -->
    <logger name="NanoServer.*" minlevel="Trace" writeTo="console,file" />
    <logger name="*" minlevel="Information" writeTo="console,file" />
  </rules>
</nlog>
